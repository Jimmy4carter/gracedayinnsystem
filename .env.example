# =====================================================================
# GRACEDAY INN HOTEL PLATFORM — ENVIRONMENT CONFIGURATION (.env)
# =====================================================================

# ---------------------------------------------------------------------
# DJANGO CORE SETTINGS
# ---------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,gracedayinn.com,www.gracedayinn.com

# ---------------------------------------------------------------------
# SITE IDENTIFICATION & BRANDING
# ---------------------------------------------------------------------
SITE_URL=https://gracedayinn.com
SITE_NAME=Grace Day Inn
HOTEL_CURRENCY=NGN
TIME_ZONE=Africa/Lagos

# ---------------------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# SQLite (development default):
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (production recommended):
# DATABASE_URL=postgresql://graceday_user:secure_password@localhost:5432/gracedayinn_db?sslmode=require

# MySQL example:
# DATABASE_URL=mysql://graceday_user:secure_password@localhost:3306/gracedayinn_db

DB_CONN_MAX_AGE=60

# Persistent deployment paths. Keep uploaded media outside disposable releases.
STATIC_ROOT=/home/CPANEL_USERNAME/gracedayinnsystem/collected_static
MEDIA_ROOT=/home/CPANEL_USERNAME/gracedayinn_media

# ---------------------------------------------------------------------
# EMAIL & TRANSACTIONAL MESSAGING CONFIGURATION
# ---------------------------------------------------------------------
# Provider choices: 'brevo_smtp' (Brevo relay), 'brevo' (REST API), or 'django' (development/test)
EMAIL_DELIVERY_PROVIDER=brevo_smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20

# Transactional Address Routing
DEFAULT_FROM_EMAIL=noreply@gracedayinn.com
SERVER_EMAIL=noreply@gracedayinn.com
HOTEL_INFO_EMAIL=info@gracedayinn.com
HOTEL_SUPPORT_EMAIL=support@gracedayinn.com

# Brevo REST API integration. Required only when EMAIL_DELIVERY_PROVIDER=brevo.
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_WEBHOOK_TOKEN=your-brevo-webhook-secret-token
BREVO_SENDER_NAME=GRACEDAY INN
BREVO_SANDBOX=False
BREVO_CONTACT_LIST_ID=0

EMAIL_OUTBOX_SEND_IMMEDIATELY=True
EMAIL_OUTBOX_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------
# AUTHENTICATION, OTP & SECURITY POLICY
# ---------------------------------------------------------------------
BOOKING_OTP_TTL_SECONDS=600
BOOKING_OTP_MAX_ATTEMPTS=5
BOOKING_OTP_SEND_LIMIT=5
BOOKING_OTP_SEND_WINDOW_SECONDS=3600
PASSWORD_SETUP_TIMEOUT_SECONDS=86400
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

STAFF_MFA_REQUIRED=False
MFA_ISSUER=GraceDay Inn
MFA_ENCRYPTION_KEY=your-32-byte-hex-mfa-key
MFA_MAX_ATTEMPTS=5
MFA_LOCK_MINUTES=15
CASH_VARIANCE_APPROVAL_THRESHOLD=1000.00

# Required deployment accounts (use a different randomly generated value for every account)
DEFAULT_ADMIN_PASSWORD=replace-with-strong-unique-password
DEFAULT_MANAGER_PASSWORD=replace-with-strong-unique-password
DEFAULT_RECEPTION_PASSWORD=replace-with-strong-unique-password
DEFAULT_ACCOUNTANT_PASSWORD=replace-with-strong-unique-password
DEFAULT_HOUSEKEEPING_PASSWORD=replace-with-strong-unique-password
DEFAULT_INFO_PASSWORD=replace-with-strong-unique-password

# ---------------------------------------------------------------------
# PRODUCTION SECURITY HARDENING & SSL
# ---------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://gracedayinn.com,https://www.gracedayinn.com
CORS_ALLOWED_ORIGINS=https://gracedayinn.com,https://www.gracedayinn.com
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------
# OBSERVABILITY & TELEMETRY
# ---------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=graceday-inn
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
RELEASE_VERSION=1.0.0

# Redis Cache & Channels (Optional for production scaling)
REDIS_URL=redis://localhost:6379/0
